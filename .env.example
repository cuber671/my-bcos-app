# ============================================
# FISCO供应链金融系统 - 环境变量配置
# ============================================
# 使用方法：
# 1. 复制此文件为 .env
#    cp .env.example .env
# 2. 修改敏感信息（JWT_SECRET等）
# 3. 启动服务: docker-compose up -d
# ============================================

# ==================== JWT配置（必需）====================
# JWT密钥（必须至少256位，用于Token签名）
# 开发环境：可以使用简单值
# 生产环境：必须使用强随机密钥
# 生成命令: openssl rand -base64 64
JWT_SECRET=dev-jwt-secret-key-for-development-only-change-this-in-production

# JWT Token过期时间（毫秒）
# 开发环境：2小时 = 7200000ms
JWT_EXPIRATION=7200000

# JWT刷新Token过期时间（毫秒）
# 开发环境：7天 = 604800000ms
JWT_REFRESH_EXPIRATION=604800000

# ==================== 数据加密配置 ====================
ENCRYPTION_KEY=dev-encryption-key-for-development-only

# ==================== 数据库配置 =====================
DB_HOST=fisco-dev-db
DB_PORT=3306
DB_NAME=fisco_data
DB_USERNAME=fisco_user
DB_PASSWORD=123456
DB_ROOT_PASSWORD=root_pwd

# ==================== CORS配置 ====================
CORS_ALLOWED_ORIGINS=*

# ==================== FISCO BCOS 区块链配置 ====================
FISCO_CONFIG_FILE=/app/sdk/config.toml
FISCO_GROUP=group0

# ==================== 智能合约地址配置 ====================
# 部署合约后，从 contract-addresses.env 复制地址到此处
# 合约部署脚本: ./scripts/deploy-all-contracts.sh

# 企业模块
CONTRACT_ENTERPRISE=
CONTRACT_ENTERPRISE_AUTH=

# 仓单模块
CONTRACT_WAREHOUSE_CORE=
CONTRACT_WAREHOUSE_OPS=
CONTRACT_WAREHOUSE_HISTORY=

# 应收款模块
CONTRACT_RECEIVABLE_CORE=
CONTRACT_RECEIVABLE_REPAYMENT=

# 信用模块
CONTRACT_CREDIT_CORE=
CONTRACT_CREDIT_SCORE=

# 票据模块
CONTRACT_BILL_CORE=
CONTRACT_BILL_OPS=

# 物流模块
CONTRACT_LOGISTICS_CORE=
CONTRACT_LOGISTICS_OPS=

# ==================== 应用服务配置 ====================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DEBUG_PORT=5005
SPRING_DEVTOOLS_RESTART_ENABLED=true

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_PATH=/app/logs

# ==================== 文件上传配置 ====================
UPLOAD_PATH=/app/data/uploads
UPLOAD_MAX_SIZE=10485760

# ==================== 限流配置 ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERIES_PER_SECOND=10
RATE_LIMIT_WRITES_PER_SECOND=2

# ==================== 链路追踪配置 ====================
TRACE_ENABLED=true
TRACE_SAMPLE_RATE=0.1

# ==================== 时区 ====================
TZ=Asia/Shanghai
